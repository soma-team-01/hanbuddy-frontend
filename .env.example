# Use an HTTPS API URL in shared deployments.
HANBUDDY_API_BASE_URL=https://api.hanbuddy.example/api/v1
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# 브라우저에 노출되는 키 (Places API·Maps Embed API 직접 호출용).
# Google Cloud Console에서 HTTP 리퍼러 제한 + API 제한(Places API, Maps Embed API)을 반드시 설정할 것.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
