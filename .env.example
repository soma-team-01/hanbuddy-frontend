# Local backend API (no /api/v1 prefix).
HANBUDDY_API_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# 브라우저에 노출되는 키 (Places API·Maps Embed API 직접 호출용).
# Google Cloud Console에서 HTTP 리퍼러 제한 + API 제한(Places API, Maps Embed API)을 반드시 설정할 것.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# PayPal JS SDK client ID (백엔드가 order 생성에 쓰는 PayPal 앱과 같은 앱이어야 함).
# 비워두면 결제 버튼이 "Payment unavailable"로 비활성화된다.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# "live"면 실결제, 그 외 값은 전부 sandbox로 동작.
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox
