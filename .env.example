# Local backend API (no /api/v1 prefix).
HANBUDDY_API_BASE_URL=http://localhost:8080
# 심사용 이메일 로그인 UI와 BFF를 함께 활성화한다. 로컬 기본값은 비활성화한다.
REVIEW_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
# 프론트 환경별 콜백 주소 하나만 설정한다. 쉼표 구분 허용 목록은 백엔드 전용이다.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# 브라우저에 노출되는 키 (Places API·Maps Embed API 직접 호출용).
# Google Cloud Console에서 HTTP 리퍼러 제한 + API 제한(Places API, Maps Embed API)을 반드시 설정할 것.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 토스 결제용 프론트 환경변수는 없다.
# 결제 준비 API가 clientKey·주문번호·금액을 내려주며, 프론트는 해당 값으로 토스 SDK를 초기화한다.

# 결제 버튼 노출: TOSS, PAYPAL, BOTH. 로컬 기본값은 두 결제수단을 모두 표시한다.
NEXT_PUBLIC_PAYMENT_PROVIDER=BOTH

# PayPal JS SDK 공개 Client ID. 비밀키는 프론트에 두지 않는다.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# 로컬은 sandbox를 기본으로 사용한다. 배포 환경은 GitHub Actions가 결정한다.
